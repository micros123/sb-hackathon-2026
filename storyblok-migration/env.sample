# Template for .env. Copy to .env and fill in the tokens:
#
#   cp env.sample .env
#
# .env is gitignored (root .gitignore: .env*); this template is not, so keep it
# free of real tokens.
#
# Generate a Personal Access Token per account (must match the space region):
#   EU: https://app.storyblok.com/#/me/account?tab=token
#   US: https://app-us.storyblok.com/#/me/account?tab=token
#
# Two separate accounts cannot share one ~/.storyblok/credentials.json, so the
# CLI reads these per command via the wrappers in copy.sh (STORYBLOK_LOGIN /
# STORYBLOK_TOKEN / STORYBLOK_REGION).

# --- Source: TomTom production space ---
TOMTOM_STORYBLOK_LOGIN=
TOMTOM_STORYBLOK_TOKEN=
TOMTOM_STORYBLOK_REGION=eu
TOMTOM_SPACE_ID=178460

# --- Target: hackathon space ---
HACKATHON_STORYBLOK_LOGIN=
HACKATHON_STORYBLOK_TOKEN=
HACKATHON_STORYBLOK_REGION=eu
HACKATHON_SPACE_ID=
