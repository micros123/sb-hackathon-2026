---
import Visual from 'components/shared/Visual.astro';
import { editable, publicHref, type Asset, type Multilink, type SbBlok } from 'utils/storyblok';

type ReelItem = SbBlok & { visual?: Asset; link?: Multilink };

type Props = {
	blok: SbBlok & { newItems?: ReelItem[]; items?: ReelItem[]; alignment?: string };
};

const { blok } = Astro.props as Props;
const items = blok.newItems ?? blok.items ?? [];
const justify = blok.alignment === 'left' ? 'justify-start' : 'justify-center';
---

<section class="tt-block py-32" {...editable(blok)}>
	<div class:list={['flex flex-wrap items-center gap-x-48 gap-y-24', justify]}>
		{
			items.map(item => (
				<a href={publicHref(item.link)} class="block">
					<Visual
						visual={item.visual}
						alt=""
						class="h-32 w-auto object-contain opacity-60 transition-opacity hover:opacity-100 desktop:h-40"
					/>
				</a>
			))
		}
	</div>
</section>
