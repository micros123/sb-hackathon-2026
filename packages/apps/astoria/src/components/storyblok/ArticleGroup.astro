---
import RichText from 'components/shared/RichText.astro';
import Visual from 'components/shared/Visual.astro';
import CtaButton from 'components/shared/CtaButton.astro';
import { editable, type Asset, type Multilink, type SbBlok } from 'utils/storyblok';

type GroupItem = SbBlok & {
	title?: unknown;
	body?: unknown;
	visual?: Asset;
	cta?: Multilink;
};

type Props = {
	blok: SbBlok & {
		title?: unknown;
		body?: unknown;
		blocks?: GroupItem[];
		imageType?: string;
	};
};

const { blok } = Astro.props as Props;
const blocks = blok.blocks ?? [];
const isIcon = blok.imageType === 'icon';
const visualClasses = isIcon ? 'h-48 w-48 object-contain' : 'h-auto w-full rounded-10';
---

<section class="tt-block py-48 desktop:py-80" {...editable(blok)}>
	<div class="mb-32 flex max-w-3xl flex-col gap-12">
		<RichText text={blok.title} class="headline2" />
		<RichText text={blok.body} class="body1" />
	</div>

	<div class="grid grid-cols-1 gap-32 tablet:grid-cols-2 desktop:grid-cols-4">
		{
			blocks.map(item => (
				<div class="flex flex-col items-start gap-12" {...editable(item)}>
					<Visual visual={item.visual} class={visualClasses} />
					<RichText text={item.title} class="headline3" />
					<RichText text={item.body} class="body2" />
					<CtaButton link={item.cta} variant="text" class="mt-auto" />
				</div>
			))
		}
	</div>
</section>
