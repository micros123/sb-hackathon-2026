---
import BasedrumRichText from 'basedrum/components/atoms/rich-text/RichText';
import type { StoryblokRichtext } from '@drumkit/storyblok/types/storyblok.d';

type Props = { text?: unknown; class?: string };

const { text, class: className } = Astro.props as Props;

const isRichtext = !!text && typeof text === 'object' && (text as { type?: string }).type === 'doc';
const isFilledString = typeof text === 'string' && text.trim().length > 0;
---

{
	isRichtext ? (
		<div class={className}>
			<BasedrumRichText text={text as StoryblokRichtext} />
		</div>
	) : isFilledString ? (
		<div class={className} set:text={text} />
	) : null
}
