---
const staticData = '/space-health.json';
const liveEndpoint = '/api/space-health';

// Storyblok block-* icon names mapped to Lucide (ISC-licensed) vector equivalents,
// rendered as the inner markup of a 24x24 stroke icon.
const iconSvg: Record<string, string> = {
	'block-cart':
		'<circle cx="8" cy="21" r="1" /> <circle cx="19" cy="21" r="1" /> <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12" />',
	'block-image':
		'<rect width="18" height="18" x="3" y="3" rx="2" ry="2" /> <circle cx="9" cy="9" r="2" /> <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" />',
	'block-email':
		'<path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7" /> <rect x="2" y="4" width="20" height="16" rx="2" />',
	'block-doc':
		'<path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z" /> <path d="M14 2v5a1 1 0 0 0 1 1h5" /> <path d="M10 9H8" /> <path d="M16 13H8" /> <path d="M16 17H8" />',
	'block-comment':
		'<path d="M22 17a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 21.286V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2z" />',
	'message-square':
		'<path d="M22 17a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 21.286V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2z" />',
	'block-tag':
		'<path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z" /> <circle cx="7.5" cy="7.5" r=".5" fill="currentColor" />',
	'block-suitcase':
		'<path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" /> <rect width="20" height="14" x="2" y="6" rx="2" />',
	'block-share':
		'<circle cx="18" cy="5" r="3" /> <circle cx="6" cy="12" r="3" /> <circle cx="18" cy="19" r="3" /> <line x1="8.59" x2="15.42" y1="13.51" y2="17.49" /> <line x1="15.41" x2="8.59" y1="6.51" y2="10.49" />',
	'block-paycard':
		'<rect width="20" height="14" x="2" y="5" rx="2" /> <line x1="2" x2="22" y1="10" y2="10" />',
	'block-buildin':
		'<path d="M10 12h4" /> <path d="M10 8h4" /> <path d="M14 21v-3a2 2 0 0 0-4 0v3" /> <path d="M6 10H4a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-2" /> <path d="M6 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16" />',
	'block-unlocked':
		'<rect width="18" height="11" x="3" y="11" rx="2" ry="2" /> <path d="M7 11V7a5 5 0 0 1 9.9-1" />',
	'block-dollar-sign':
		'<line x1="12" x2="12" y1="2" y2="22" /> <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />',
	'block-@':
		'<circle cx="12" cy="12" r="4" /> <path d="M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-4 8" />',
	'block-add': '<path d="M5 12h14" /> <path d="M12 5v14" />',
	'block-arrow-pointer':
		'<path d="M4.037 4.688a.495.495 0 0 1 .651-.651l16 6.5a.5.5 0 0 1-.063.947l-6.124 1.58a2 2 0 0 0-1.438 1.435l-1.579 6.126a.5.5 0 0 1-.947.063z" />',
	'block-block': '<rect width="18" height="18" x="3" y="3" rx="2" />',
	'block-table':
		'<rect width="18" height="18" x="3" y="3" rx="2" /> <path d="M9 3v18" /> <path d="M15 3v18" />',
	'block-table-2':
		'<path d="M12 3v18" /> <rect width="18" height="18" x="3" y="3" rx="2" /> <path d="M3 9h18" /> <path d="M3 15h18" />',
	'block-text-l': '<path d="M21 5H3" /> <path d="M15 12H3" /> <path d="M17 19H3" />',
	'block-text-img-l': '<rect width="18" height="18" x="3" y="3" rx="2" /> <path d="M9 3v18" />',
	'block-text-img-r': '<rect width="18" height="18" x="3" y="3" rx="2" /> <path d="M15 3v18" />',
	'block-text-img-t-l': '<rect width="18" height="18" x="3" y="3" rx="2" /> <path d="M3 9h18" />',
	'block-text-img-c':
		'<rect width="18" height="7" x="3" y="3" rx="1" /> <rect width="9" height="7" x="3" y="14" rx="1" /> <rect width="5" height="7" x="16" y="14" rx="1" />',
	'block-text-img-r-l':
		'<rect width="18" height="18" x="3" y="3" rx="2" /> <path d="M12 3v18" />',
	'block-center-m':
		'<rect width="18" height="7" x="3" y="3" rx="1" /> <rect width="9" height="7" x="3" y="14" rx="1" /> <rect width="5" height="7" x="16" y="14" rx="1" />',
	'block-1-2block': '<rect width="18" height="18" x="3" y="3" rx="2" /> <path d="M12 3v18" />',
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Storyblok space health</title>
		<style is:global>
			:root {
				--ink: #1b243f;
				--teal: #09b3af;
				--green: #4caf7d;
				--amber: #f0a020;
				--red: #e2526b;
				--bg: #f3f5fb;
				--card: #ffffff;
				--line: #e6e9f2;
				--muted: #7a829b;
			}
			* {
				box-sizing: border-box;
			}
			body {
				margin: 0;
				background: var(--bg);
				color: var(--ink);
				font-family:
					ui-sans-serif,
					system-ui,
					-apple-system,
					'Segoe UI',
					Roboto,
					sans-serif;
			}
			.bar {
				background: linear-gradient(100deg, var(--ink), #2a3556);
				color: #fff;
				padding: 26px 32px;
			}
			.bar h1 {
				margin: 0;
				font-size: 24px;
				font-weight: 800;
				letter-spacing: -0.4px;
				display: flex;
				align-items: center;
				gap: 10px;
			}
			.bar .logo {
				width: 28px;
				height: 28px;
				border-radius: 8px;
				background: var(--teal);
				display: inline-flex;
				align-items: center;
				justify-content: center;
				font-weight: 900;
				color: #06231f;
			}
			.bar p {
				margin: 6px 0 0;
				color: #b9c0d6;
				font-size: 14px;
			}
			.bar .sourcebar {
				margin-top: 14px;
				display: flex;
				gap: 8px;
				flex-wrap: wrap;
			}
			.bar button {
				background: rgba(255, 255, 255, 0.1);
				border: 1px solid rgba(255, 255, 255, 0.2);
				color: #fff;
				border-radius: 8px;
				padding: 7px 13px;
				font: inherit;
				font-size: 13px;
				cursor: pointer;
			}
			.bar button:hover {
				background: rgba(255, 255, 255, 0.18);
			}
			.wrap {
				max-width: 1180px;
				margin: -18px auto 48px;
				padding: 0 24px;
			}
			.state {
				color: var(--muted);
				padding: 30px 4px;
			}
			.state.error {
				color: var(--red);
			}
			.cards {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
				gap: 14px;
				margin-bottom: 20px;
			}
			.card {
				background: var(--card);
				border-radius: 16px;
				padding: 18px;
				box-shadow: 0 6px 20px rgba(27, 36, 63, 0.06);
			}
			.card .num {
				font-size: 30px;
				font-weight: 800;
			}
			.card .lbl {
				font-size: 12px;
				color: var(--muted);
				margin-top: 4px;
				font-weight: 600;
			}
			.panels {
				display: grid;
				grid-template-columns: 340px 1fr;
				gap: 16px;
				align-items: start;
			}
			@media (max-width: 880px) {
				.panels {
					grid-template-columns: 1fr;
				}
			}
			.panel {
				background: var(--card);
				border-radius: 16px;
				padding: 20px;
				box-shadow: 0 6px 20px rgba(27, 36, 63, 0.06);
			}
			.panel h2 {
				font-size: 13px;
				text-transform: uppercase;
				letter-spacing: 1px;
				color: var(--muted);
				margin: 0 0 16px;
			}
			.donutwrap {
				display: flex;
				align-items: center;
				gap: 18px;
			}
			.leg {
				display: flex;
				flex-direction: column;
				gap: 9px;
				font-size: 13px;
				flex: 1;
			}
			.leg .r {
				display: flex;
				align-items: center;
				gap: 8px;
				cursor: pointer;
				padding: 3px 5px;
				border-radius: 7px;
			}
			.leg .r:hover {
				background: #f3f5fb;
			}
			.leg .r.active {
				background: #eaf6f5;
				outline: 1px solid var(--teal);
			}
			.leg .sw {
				width: 12px;
				height: 12px;
				border-radius: 4px;
				flex: 0 0 auto;
			}
			.leg b {
				font-variant-numeric: tabular-nums;
			}
			.leg .m {
				color: var(--muted);
			}
			.scorewrap {
				display: flex;
				justify-content: center;
				margin-bottom: 12px;
			}
			.tileshint {
				font-size: 11px;
				color: var(--muted);
				margin: 0 0 12px;
			}
			.tiles {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 10px;
			}
			.tile {
				border: 1px solid var(--line);
				border-left: 4px solid var(--line);
				border-radius: 12px;
				padding: 12px;
				cursor: pointer;
				background: #fff;
				transition:
					box-shadow 0.15s,
					transform 0.05s;
			}
			.tile.info {
				cursor: default;
			}
			.tile:hover:not(.info) {
				box-shadow: 0 4px 14px rgba(27, 36, 63, 0.1);
			}
			.tile:active:not(.info) {
				transform: translateY(1px);
			}
			.tile.on {
				outline: 2px solid var(--teal);
			}
			.tile .te {
				font-size: 20px;
				line-height: 1;
			}
			.tile .tl {
				font-size: 12.5px;
				font-weight: 700;
				margin-top: 6px;
			}
			.tile .tv {
				font-size: 12px;
				color: var(--muted);
				margin-top: 2px;
				font-variant-numeric: tabular-nums;
			}
			.tile .tbar {
				height: 5px;
				border-radius: 3px;
				background: #eef0f7;
				margin-top: 8px;
				overflow: hidden;
			}
			.tile .tbar span {
				display: block;
				height: 100%;
			}
			.chips {
				display: flex;
				gap: 8px;
				flex-wrap: wrap;
				margin-bottom: 14px;
			}
			.chips button {
				border: none;
				background: #eef0f7;
				color: var(--ink);
				border-radius: 999px;
				padding: 9px 16px;
				font: inherit;
				font-size: 13px;
				font-weight: 600;
				cursor: pointer;
			}
			.chips button:hover {
				background: #e3e7f2;
			}
			.chips button.on {
				background: var(--teal);
				color: #06231f;
			}
			.tablewrap {
				max-height: 620px;
				overflow: auto;
			}
			table {
				width: 100%;
				border-collapse: separate;
				border-spacing: 0;
				font-size: 14px;
			}
			th {
				text-align: left;
				color: var(--muted);
				font-size: 12px;
				text-transform: uppercase;
				letter-spacing: 0.5px;
				padding: 10px 12px;
				cursor: pointer;
				user-select: none;
				white-space: nowrap;
				position: sticky;
				top: 0;
				background: var(--card);
			}
			td {
				padding: 11px 12px;
				border-top: 1px solid var(--line);
				vertical-align: middle;
			}
			tbody tr:hover td {
				background: #f7f9ff;
			}
			.comp {
				font-weight: 700;
			}
			.num {
				text-align: left;
				font-variant-numeric: tabular-nums;
				font-weight: 600;
			}
			.zero {
				color: var(--red);
			}
			.pill {
				display: inline-block;
				padding: 3px 10px;
				border-radius: 999px;
				font-size: 12px;
				font-weight: 700;
				text-transform: capitalize;
			}
			.icon-badge {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				width: 34px;
				height: 34px;
				border-radius: 8px;
				flex: 0 0 auto;
			}
			.icon-badge.empty {
				background: #eef0f7;
			}
			.color-swatch {
				display: inline-block;
				width: 16px;
				height: 16px;
				border-radius: 4px;
				border: 1px solid rgba(0, 0, 0, 0.12);
				vertical-align: middle;
			}
			.muted-dash {
				color: #b6bccb;
			}
			.dot {
				display: inline-block;
				width: 9px;
				height: 9px;
				border-radius: 50%;
			}
			.rowcount {
				color: var(--muted);
				font-size: 12px;
				margin: 0 0 10px;
			}
			.search {
				background: #f3f5fb;
				border: 1px solid var(--line);
				color: var(--ink);
				border-radius: 10px;
				padding: 9px 12px;
				font: inherit;
				font-size: 13px;
				width: 100%;
				margin-bottom: 12px;
			}
		</style>
	</head>
	<body>
		<div class="bar">
			<h1><span class="logo">S</span> Space health</h1>
			<p id="subtitle">Loading component insights…</p>
			<div class="sourcebar">
				<button id="btn-static">Static snapshot</button>
				<button id="btn-live">Refresh live from Storyblok</button>
			</div>
		</div>
		<div class="wrap">
			<div class="state" id="state">Loading…</div>
			<div id="dashboard" style="display: none">
				<div class="cards" id="cards"></div>
				<div class="panels">
					<div class="panel">
						<h2>Space health</h2>
						<div class="scorewrap"><div id="score"></div></div>
						<p class="tileshint">
							Quick wins — click a tile to see the components that need it.
						</p>
						<div class="tiles" id="tiles"></div>
					</div>
					<div class="panel">
						<h2>Components</h2>
						<div class="chips" id="chips"></div>
						<input
							type="search"
							class="search"
							id="search"
							placeholder="Filter by name…"
						/>
						<div class="rowcount" id="rowcount"></div>
						<div class="tablewrap">
							<table>
								<thead>
									<tr>
										<th data-sort="name">Component</th>
										<th data-sort="role">Role</th>
										<th data-sort="classification">Type</th>
										<th class="num" data-sort="pageSectionUsage">In page</th>
										<th class="num" data-sort="totalUsage">Total</th>
										<th class="num" data-sort="nestedUsage">Nested</th>
										<th class="num" data-sort="storyCount">Stories</th>
										<th data-sort="icon">Icon</th>
										<th data-sort="color">Color</th>
										<th>Preview</th>
										<th>Preset</th>
									</tr>
								</thead>
								<tbody id="rows"></tbody>
							</table>
						</div>
					</div>
				</div>
			</div>
		</div>

		<script is:inline define:vars={{ staticData, liveEndpoint, iconSvg }}>
			let REPORT = null;
			let activeFilter = 'in-page';
			let sortKey = 'pageSectionUsage';
			let sortDir = -1;

			const ICON_SVG = iconSvg;
			const RC = {
				page: '#09b3af',
				section: '#4caf7d',
				subcomponent: '#f0a020',
				unused: '#e2526b',
			};

			const CHIPS = [
				{ id: 'in-page', label: 'In page' },
				{ id: 'all', label: 'All' },
				{ id: 'role:page', label: 'Page' },
				{ id: 'role:section', label: 'Section' },
				{ id: 'role:subcomponent', label: 'Subcomponent' },
				{ id: 'role:unused', label: 'Unused' },
				{ id: 'no-icon', label: 'Missing icon' },
				{ id: 'no-color', label: 'Missing color' },
				{ id: 'no-preview', label: 'Missing preview' },
			];

			const escapeHtml = value =>
				String(value).replace(
					/[&<>"]/g,
					ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[ch]
				);

			function predicate(c, mode) {
				if (mode === 'all') return true;
				if (mode === 'in-page') return c.pageSectionUsage > 0;
				if (mode === 'used') return c.totalUsage > 0;
				if (mode === 'unused') return c.totalUsage === 0;
				if (mode === 'no-icon') return !c.hasIcon;
				if (mode === 'no-color') return !c.hasColor;
				if (mode === 'no-preview') return !c.hasPreview;
				if (mode === 'no-preset') return !c.hasPreset;
				if (mode.startsWith('role:')) return c.role === mode.slice(5);
				return true;
			}

			function setFilter(mode) {
				activeFilter = mode;
				renderChips();
				renderTilesActive();
				renderTable();
			}

			function severity(pct) {
				return pct >= 80 ? '#4caf7d' : pct >= 40 ? '#f0a020' : '#e2526b';
			}

			function isLight(hex) {
				const match = /^#([0-9a-f]{6})$/i.exec(hex || '');
				if (!match) return false;
				const int = parseInt(match[1], 16);
				const r = (int >> 16) & 255;
				const g = (int >> 8) & 255;
				const b = int & 255;
				return (0.299 * r + 0.587 * g + 0.114 * b) / 255 > 0.62;
			}

			function iconGlyph(name, color) {
				const body = ICON_SVG[name];
				if (!body) return '';
				return (
					'<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="' +
					color +
					'" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' +
					body +
					'</svg>'
				);
			}

			function iconBadge(c) {
				if (!c.icon && !c.color) return '<span class="icon-badge empty"></span>';
				const bg = c.color && /^#[0-9a-f]{6}$/i.test(c.color) ? c.color : '#eef0f7';
				const fg = isLight(bg) ? '#10131a' : '#ffffff';
				return (
					'<span class="icon-badge" style="background:' +
					bg +
					'" title="' +
					escapeHtml((c.icon || 'no icon') + (c.color ? ' · ' + c.color : '')) +
					'">' +
					(c.icon ? iconGlyph(c.icon, fg) : '') +
					'</span>'
				);
			}

			function colorCell(c) {
				if (!c.color) return '<span class="muted-dash">—</span>';
				const isHex = /^#[0-9a-f]{6}$/i.test(c.color);
				const bg = isHex
					? c.color
					: 'repeating-linear-gradient(45deg,#ccc,#ccc 4px,#eee 4px,#eee 8px)';
				return (
					'<span class="color-swatch" style="background:' +
					bg +
					'" title="' +
					escapeHtml(c.color) +
					'"></span>'
				);
			}

			function dot(on) {
				return (
					'<span class="dot" style="background:' +
					(on ? '#4caf7d' : '#dfe3ee') +
					'"></span>'
				);
			}

			function renderChips() {
				document.getElementById('chips').innerHTML = CHIPS.map(
					chip =>
						'<button class="' +
						(activeFilter === chip.id ? 'on' : '') +
						'" data-filter="' +
						chip.id +
						'">' +
						chip.label +
						'</button>'
				).join('');
				document
					.querySelectorAll('.chips button')
					.forEach(b =>
						b.addEventListener('click', () => setFilter(b.getAttribute('data-filter')))
					);
			}

			function arcPath(cx, cy, radius, startAngle, endAngle) {
				const toXy = angle => [
					cx + radius * Math.cos(angle),
					cy + radius * Math.sin(angle),
				];
				const [x1, y1] = toXy(startAngle);
				const [x2, y2] = toXy(endAngle);
				const large = endAngle - startAngle > Math.PI ? 1 : 0;
				return (
					'M ' +
					cx +
					' ' +
					cy +
					' L ' +
					x1 +
					' ' +
					y1 +
					' A ' +
					radius +
					' ' +
					radius +
					' 0 ' +
					large +
					' 1 ' +
					x2 +
					' ' +
					y2 +
					' Z'
				);
			}

			function ringGauge(pct, size) {
				const cx = size / 2;
				const cy = size / 2;
				const radius = size / 2 - 6;
				const color = severity(pct);
				const track = arcPath(
					cx,
					cy,
					radius,
					-Math.PI / 2,
					-Math.PI / 2 + Math.PI * 2 - 0.0001
				);
				const filled = arcPath(
					cx,
					cy,
					radius,
					-Math.PI / 2,
					-Math.PI / 2 + Math.PI * 2 * (pct / 100)
				);
				return (
					'<svg width="' +
					size +
					'" height="' +
					size +
					'" viewBox="0 0 ' +
					size +
					' ' +
					size +
					'">' +
					'<path d="' +
					track +
					'" fill="none" stroke="#eef0f7" stroke-width="12" stroke-linecap="round" />' +
					'<path d="' +
					filled +
					'" fill="none" stroke="' +
					color +
					'" stroke-width="12" stroke-linecap="round" />' +
					'<text x="' +
					cx +
					'" y="' +
					(cy - 2) +
					'" text-anchor="middle" fill="#1b243f" font-size="30" font-weight="800">' +
					pct +
					'</text>' +
					'<text x="' +
					cx +
					'" y="' +
					(cy + 16) +
					'" text-anchor="middle" fill="#7a829b" font-size="11" font-weight="600">HEALTH</text>' +
					'</svg>'
				);
			}

			function buildTiles() {
				const s = REPORT.summary;
				const total = s.totalComponents;
				const seo = REPORT.signals && REPORT.signals.seo;
				const tiles = [
					{ emoji: '🎨', label: 'Icons', have: s.withIcon, total, filter: 'no-icon' },
					{ emoji: '🌈', label: 'Colors', have: s.withColor, total, filter: 'no-color' },
					{
						emoji: '📷',
						label: 'Previews',
						have: s.withPreview,
						total,
						filter: 'no-preview',
					},
					{
						emoji: '🧩',
						label: 'Presets',
						have: s.withPreset,
						total,
						filter: 'no-preset',
					},
				];
				if (seo && seo.totalStories) {
					tiles.push({
						emoji: '🔍',
						label: 'SEO',
						have: seo.withTitle,
						total: seo.totalStories,
						unit: 'stories',
						filter: null,
					});
				}
				return tiles.map(t => ({
					...t,
					pct: t.total ? Math.round((t.have / t.total) * 100) : 0,
				}));
			}

			function renderTiles() {
				const tiles = buildTiles().sort((a, b) => a.pct - b.pct);
				document.getElementById('tiles').innerHTML = tiles
					.map(t => {
						const color = severity(t.pct);
						const cls =
							'tile' +
							(t.filter ? '' : ' info') +
							(t.filter && activeFilter === t.filter ? ' on' : '');
						const unit = t.unit || 'components';
						return (
							'<div class="' +
							cls +
							'"' +
							(t.filter ? ' data-filter="' + t.filter + '"' : '') +
							' style="border-left-color:' +
							color +
							'">' +
							'<div class="te">' +
							t.emoji +
							'</div>' +
							'<div class="tl">' +
							t.label +
							'</div>' +
							'<div class="tv">' +
							t.have +
							'/' +
							t.total +
							' ' +
							unit +
							' · ' +
							t.pct +
							'%</div>' +
							'<div class="tbar"><span style="width:' +
							t.pct +
							'%;background:' +
							color +
							'"></span></div>' +
							'</div>'
						);
					})
					.join('');
				document
					.querySelectorAll('#tiles .tile[data-filter]')
					.forEach(el =>
						el.addEventListener('click', () =>
							setFilter(el.getAttribute('data-filter'))
						)
					);
			}

			function renderTilesActive() {
				document
					.querySelectorAll('#tiles .tile[data-filter]')
					.forEach(el =>
						el.classList.toggle('on', el.getAttribute('data-filter') === activeFilter)
					);
			}

			function healthScore() {
				const tiles = buildTiles();
				if (!tiles.length) return 0;
				return Math.round(tiles.reduce((sum, t) => sum + t.pct, 0) / tiles.length);
			}

			function renderTable() {
				const term = document.getElementById('search').value.toLowerCase();
				const rows = REPORT.components
					.filter(c => c.name.toLowerCase().includes(term) && predicate(c, activeFilter))
					.sort((a, b) => {
						const av = a[sortKey];
						const bv = b[sortKey];
						if (typeof av === 'string')
							return (av || '').localeCompare(bv || '') * sortDir;
						return (av - bv) * sortDir;
					});
				document.getElementById('rowcount').textContent =
					rows.length + ' of ' + REPORT.components.length + ' components';
				document.getElementById('rows').innerHTML = rows
					.map(
						c =>
							'<tr>' +
							'<td class="comp">' +
							escapeHtml(c.name) +
							'</td>' +
							'<td><span class="pill" style="background:' +
							RC[c.role] +
							'22;color:' +
							RC[c.role] +
							'">' +
							c.role +
							'</span></td>' +
							'<td>' +
							c.classification +
							'</td>' +
							'<td class="num">' +
							c.pageSectionUsage +
							'</td>' +
							'<td class="num ' +
							(c.totalUsage === 0 ? 'zero' : '') +
							'">' +
							c.totalUsage +
							'</td>' +
							'<td class="num">' +
							c.nestedUsage +
							'</td>' +
							'<td class="num">' +
							c.storyCount +
							'</td>' +
							'<td>' +
							iconBadge(c) +
							'</td>' +
							'<td>' +
							colorCell(c) +
							'</td>' +
							'<td>' +
							dot(c.hasPreview) +
							'</td>' +
							'<td>' +
							dot(c.hasPreset) +
							'</td>' +
							'</tr>'
					)
					.join('');
			}

			function render() {
				const s = REPORT.summary;
				document.getElementById('subtitle').textContent =
					'Space ' +
					REPORT.spaceId +
					' · ' +
					REPORT.storiesAnalysed +
					' stories · ' +
					s.totalComponents +
					' components · ' +
					REPORT.contentVersion;

				const cards = [
					{ num: s.pageSectionComponents, lbl: 'In page body' },
					{ num: s.rolePage, lbl: 'Page types' },
					{ num: s.roleSubcomponent, lbl: 'Subcomponents' },
					{ num: s.roleUnused, lbl: 'Unused' },
					{ num: s.withIcon, lbl: 'With icon' },
					{ num: s.withColor, lbl: 'With color' },
					{ num: s.withPreview, lbl: 'With preview' },
					{ num: s.withPreset, lbl: 'With preset' },
				];
				document.getElementById('cards').innerHTML = cards
					.map(
						c =>
							'<div class="card"><div class="num">' +
							c.num +
							'</div><div class="lbl">' +
							c.lbl +
							'</div></div>'
					)
					.join('');

				document.getElementById('score').innerHTML = ringGauge(healthScore(), 150);
				renderTiles();

				renderChips();
				renderTilesActive();

				document.querySelectorAll('th[data-sort]').forEach(th => {
					th.addEventListener('click', () => {
						const key = th.getAttribute('data-sort');
						if (sortKey === key) sortDir *= -1;
						else {
							sortKey = key;
							sortDir = typeof REPORT.components[0][key] === 'string' ? 1 : -1;
						}
						renderTable();
					});
				});
				document.getElementById('search').addEventListener('input', renderTable);

				document.getElementById('state').style.display = 'none';
				document.getElementById('dashboard').style.display = 'block';
				renderTable();
			}

			async function load(source, label) {
				const state = document.getElementById('state');
				document.getElementById('dashboard').style.display = 'none';
				state.className = 'state';
				state.style.display = 'block';
				state.textContent = 'Loading ' + label + '…';
				try {
					const response = await fetch(source);
					const body = await response.json();
					if (!response.ok)
						throw new Error(body.error || 'Request failed (' + response.status + ')');
					REPORT = body;
					render();
				} catch (error) {
					state.className = 'state error';
					state.textContent = 'Failed to load ' + label + ': ' + error.message;
				}
			}

			document
				.getElementById('btn-static')
				.addEventListener('click', () => load(staticData, 'static snapshot'));
			document
				.getElementById('btn-live')
				.addEventListener('click', () => load(liveEndpoint, 'live data'));

			load(staticData, 'static snapshot');
		</script>
	</body>
</html>
