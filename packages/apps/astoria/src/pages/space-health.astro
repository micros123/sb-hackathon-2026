---
const endpoint = '/api/space-health';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Storyblok space health</title>
		<style>
			:root {
				--bg: #0f1117;
				--panel: #171a22;
				--panel-2: #1f2330;
				--line: #2a2f3d;
				--text: #e6e8ee;
				--muted: #9aa1b1;
				--accent: #09b3af;
				--warn: #f0a020;
				--bad: #e2526b;
			}
			* {
				box-sizing: border-box;
			}
			body {
				margin: 0;
				font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
				background: var(--bg);
				color: var(--text);
				padding: 32px;
			}
			h1 {
				font-size: 22px;
				margin: 0 0 4px;
			}
			.sub {
				color: var(--muted);
				font-size: 13px;
				margin-bottom: 24px;
			}
			.state {
				color: var(--muted);
				font-size: 14px;
				padding: 40px 0;
			}
			.state.error {
				color: var(--bad);
			}
			.cards {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
				gap: 12px;
				margin-bottom: 28px;
			}
			.card {
				background: var(--panel);
				border: 1px solid var(--line);
				border-radius: 10px;
				padding: 16px;
			}
			.card .num {
				font-size: 28px;
				font-weight: 700;
			}
			.card .lbl {
				color: var(--muted);
				font-size: 12px;
				text-transform: uppercase;
				letter-spacing: 0.5px;
				margin-top: 4px;
			}
			.grid2 {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 20px;
				margin-bottom: 28px;
			}
			@media (max-width: 880px) {
				.grid2 {
					grid-template-columns: 1fr;
				}
			}
			.panel {
				background: var(--panel);
				border: 1px solid var(--line);
				border-radius: 10px;
				padding: 18px;
			}
			.panel h2 {
				font-size: 14px;
				margin: 0 0 14px;
				text-transform: uppercase;
				letter-spacing: 0.5px;
				color: var(--muted);
			}
			.bar-row {
				display: flex;
				align-items: center;
				gap: 10px;
				margin-bottom: 7px;
				font-size: 13px;
			}
			.bar-row .name {
				width: 190px;
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
			}
			.bar-track {
				flex: 1;
				background: var(--panel-2);
				border-radius: 4px;
				height: 16px;
				overflow: hidden;
			}
			.bar-fill {
				height: 100%;
				background: var(--accent);
			}
			.bar-row .val {
				width: 44px;
				text-align: right;
				color: var(--muted);
			}
			.controls {
				display: flex;
				gap: 10px;
				align-items: center;
				margin-bottom: 12px;
				flex-wrap: wrap;
			}
			input[type='search'],
			select {
				background: var(--panel-2);
				border: 1px solid var(--line);
				color: var(--text);
				border-radius: 8px;
				padding: 8px 10px;
				font-size: 13px;
			}
			input[type='search'] {
				flex: 1;
				min-width: 180px;
			}
			table {
				width: 100%;
				border-collapse: collapse;
				font-size: 13px;
			}
			th,
			td {
				text-align: left;
				padding: 8px 10px;
				border-bottom: 1px solid var(--line);
			}
			th {
				color: var(--muted);
				font-weight: 600;
				cursor: pointer;
				user-select: none;
				white-space: nowrap;
			}
			th.num,
			td.num {
				text-align: right;
			}
			tbody tr:hover {
				background: var(--panel-2);
			}
			.tag {
				display: inline-block;
				padding: 2px 8px;
				border-radius: 20px;
				font-size: 11px;
				font-weight: 600;
			}
			.tag.page {
				background: rgba(9, 179, 175, 0.15);
				color: var(--accent);
			}
			.tag.nested {
				background: rgba(240, 160, 32, 0.15);
				color: var(--warn);
			}
			.tag.universal {
				background: rgba(126, 140, 255, 0.18);
				color: #9aa6ff;
			}
			.tag.unclassified {
				background: rgba(154, 161, 177, 0.15);
				color: var(--muted);
			}
			.dot {
				display: inline-block;
				width: 9px;
				height: 9px;
				border-radius: 50%;
			}
			.dot.yes {
				background: #4caf7d;
			}
			.dot.no {
				background: #3a3f4d;
			}
			.zero {
				color: var(--bad);
				font-weight: 600;
			}
		</style>
	</head>
	<body>
		<h1>Storyblok space health</h1>
		<div class="sub" id="subtitle">Loading component insights...</div>
		<div class="state" id="state">Scanning space, this can take a moment...</div>
		<div id="dashboard" style="display:none">
			<div class="cards" id="cards"></div>
			<div class="grid2">
				<div class="panel"><h2>Most used components</h2><div id="most"></div></div>
				<div class="panel"><h2>Metadata coverage</h2><div id="coverage"></div></div>
			</div>
			<div class="panel">
				<h2>All components</h2>
				<div class="controls">
					<input type="search" id="search" placeholder="Filter by name..." />
					<select id="filter">
						<option value="all">All</option>
						<option value="used">Used only</option>
						<option value="unused">Unused only</option>
						<option value="page">Page components</option>
						<option value="nested">Nested components</option>
						<option value="universal">Universal</option>
						<option value="no-icon">Missing icon</option>
						<option value="no-color">Missing color</option>
						<option value="no-preview">Missing preview</option>
					</select>
				</div>
				<table>
					<thead
						><tr>
							<th data-sort="name">Component</th>
							<th data-sort="classification">Type</th>
							<th class="num" data-sort="totalUsage">Total</th>
							<th class="num" data-sort="asRootUsage">As page</th>
							<th class="num" data-sort="nestedUsage">Nested</th>
							<th class="num" data-sort="storyCount">Stories</th>
							<th>Icon</th>
							<th>Color</th>
							<th>Preview</th>
						</tr></thead
					>
					<tbody id="rows"></tbody>
				</table>
			</div>
		</div>

		<script is:inline define:vars={{ endpoint }}>
			let REPORT = null;
			let sortKey = 'totalUsage';
			let sortDir = -1;

			const escapeHtml = value =>
				String(value).replace(
					/[&<>"]/g,
					ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[ch]
				);

			function dot(on) {
				return '<span class="dot ' + (on ? 'yes' : 'no') + '"></span>';
			}

			function passesFilter(component, mode) {
				switch (mode) {
					case 'used':
						return component.totalUsage > 0;
					case 'unused':
						return component.totalUsage === 0;
					case 'page':
						return component.classification === 'page';
					case 'nested':
						return component.classification === 'nested';
					case 'universal':
						return component.classification === 'universal';
					case 'no-icon':
						return !component.hasIcon;
					case 'no-color':
						return !component.hasColor;
					case 'no-preview':
						return !component.hasPreview;
					default:
						return true;
				}
			}

			function renderTable() {
				const term = document.getElementById('search').value.toLowerCase();
				const mode = document.getElementById('filter').value;
				const rows = REPORT.components
					.filter(c => c.name.toLowerCase().includes(term) && passesFilter(c, mode))
					.sort((a, b) => {
						const av = a[sortKey];
						const bv = b[sortKey];
						if (typeof av === 'string') return av.localeCompare(bv) * sortDir;
						return (av - bv) * sortDir;
					});
				document.getElementById('rows').innerHTML = rows
					.map(
						c =>
							'<tr>' +
							'<td>' +
							escapeHtml(c.name) +
							'</td>' +
							'<td><span class="tag ' +
							c.classification +
							'">' +
							c.classification +
							'</span></td>' +
							'<td class="num ' +
							(c.totalUsage === 0 ? 'zero' : '') +
							'">' +
							c.totalUsage +
							'</td>' +
							'<td class="num">' +
							c.asRootUsage +
							'</td>' +
							'<td class="num">' +
							c.nestedUsage +
							'</td>' +
							'<td class="num">' +
							c.storyCount +
							'</td>' +
							'<td>' +
							dot(c.hasIcon) +
							'</td>' +
							'<td>' +
							dot(c.hasColor) +
							'</td>' +
							'<td>' +
							dot(c.hasPreview) +
							'</td>' +
							'</tr>'
					)
					.join('');
			}

			function coverageBar(label, value, total) {
				const pct = total ? Math.round((value / total) * 100) : 0;
				return (
					'<div class="bar-row"><span class="name">' +
					label +
					'</span><span class="bar-track"><span class="bar-fill" style="width:' +
					pct +
					'%"></span></span><span class="val">' +
					pct +
					'%</span></div>'
				);
			}

			function renderDashboard() {
				const s = REPORT.summary;
				document.getElementById('subtitle').textContent =
					'Space ' +
					REPORT.spaceId +
					' · ' +
					REPORT.storiesAnalysed +
					' stories analysed (' +
					REPORT.contentVersion +
					')';

				const cards = [
					{ num: s.totalComponents, lbl: 'Components' },
					{ num: s.usedComponents, lbl: 'Used' },
					{ num: s.unusedComponents, lbl: 'Unused' },
					{ num: s.pageComponents, lbl: 'Page' },
					{ num: s.nestedComponents, lbl: 'Nested' },
					{ num: s.universalComponents, lbl: 'Universal' },
					{ num: s.withIcon, lbl: 'With icon' },
					{ num: s.withColor, lbl: 'With color' },
					{ num: s.withPreview, lbl: 'With preview' },
				];
				document.getElementById('cards').innerHTML = cards
					.map(
						c =>
							'<div class="card"><div class="num">' +
							c.num +
							'</div><div class="lbl">' +
							c.lbl +
							'</div></div>'
					)
					.join('');

				const topUsed = REPORT.components.filter(c => c.totalUsage > 0).slice(0, 15);
				const maxUsage = topUsed.length ? topUsed[0].totalUsage : 1;
				document.getElementById('most').innerHTML = topUsed
					.map(
						c =>
							'<div class="bar-row"><span class="name">' +
							escapeHtml(c.name) +
							'</span><span class="bar-track"><span class="bar-fill" style="width:' +
							(c.totalUsage / maxUsage) * 100 +
							'%"></span></span><span class="val">' +
							c.totalUsage +
							'</span></div>'
					)
					.join('');

				document.getElementById('coverage').innerHTML =
					coverageBar('Has icon', s.withIcon, s.totalComponents) +
					coverageBar('Has color', s.withColor, s.totalComponents) +
					coverageBar('Has preview', s.withPreview, s.totalComponents) +
					coverageBar('Used in content', s.usedComponents, s.totalComponents);

				document.querySelectorAll('th[data-sort]').forEach(th => {
					th.addEventListener('click', () => {
						const key = th.getAttribute('data-sort');
						if (sortKey === key) sortDir *= -1;
						else {
							sortKey = key;
							sortDir = typeof REPORT.components[0][key] === 'string' ? 1 : -1;
						}
						renderTable();
					});
				});
				document.getElementById('search').addEventListener('input', renderTable);
				document.getElementById('filter').addEventListener('change', renderTable);

				document.getElementById('state').style.display = 'none';
				document.getElementById('dashboard').style.display = 'block';
				renderTable();
			}

			async function load() {
				try {
					const response = await fetch(endpoint);
					const body = await response.json();
					if (!response.ok) {
						throw new Error(body.error || 'Request failed (' + response.status + ')');
					}
					REPORT = body;
					renderDashboard();
				} catch (error) {
					const state = document.getElementById('state');
					state.className = 'state error';
					state.textContent = 'Failed to load space health: ' + error.message;
					document.getElementById('subtitle').textContent = '';
				}
			}

			load();
		</script>
	</body>
</html>
