---
const staticData = '/space-health.json';
const liveEndpoint = '/api/space-health';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Storyblok space health</title>
		<style>
			:root {
				--bg: #0f1117;
				--panel: #171a22;
				--panel-2: #1f2330;
				--line: #2a2f3d;
				--text: #e6e8ee;
				--muted: #9aa1b1;
				--accent: #09b3af;
				--page: #09b3af;
				--nested: #f0a020;
				--universal: #7e8cff;
				--unclassified: #6b7280;
				--bad: #e2526b;
				--good: #4caf7d;
			}
			* {
				box-sizing: border-box;
			}
			body {
				margin: 0;
				font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
				background: var(--bg);
				color: var(--text);
				padding: 32px;
			}
			h1 {
				font-size: 22px;
				margin: 0 0 4px;
			}
			.sub {
				color: var(--muted);
				font-size: 13px;
				margin-bottom: 20px;
			}
			.sourcebar {
				display: flex;
				gap: 10px;
				align-items: center;
				margin-bottom: 24px;
				flex-wrap: wrap;
			}
			button {
				background: var(--panel-2);
				border: 1px solid var(--line);
				color: var(--text);
				border-radius: 8px;
				padding: 8px 12px;
				font-size: 13px;
				cursor: pointer;
			}
			button:hover {
				border-color: var(--accent);
			}
			button:disabled {
				opacity: 0.5;
				cursor: default;
			}
			.state {
				color: var(--muted);
				font-size: 14px;
				padding: 40px 0;
			}
			.state.error {
				color: var(--bad);
			}
			.cards {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
				gap: 12px;
				margin-bottom: 24px;
			}
			.card {
				background: var(--panel);
				border: 1px solid var(--line);
				border-radius: 10px;
				padding: 16px;
			}
			.card .num {
				font-size: 26px;
				font-weight: 700;
			}
			.card .lbl {
				color: var(--muted);
				font-size: 12px;
				text-transform: uppercase;
				letter-spacing: 0.5px;
				margin-top: 4px;
			}
			.grid2 {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 20px;
				margin-bottom: 24px;
			}
			@media (max-width: 880px) {
				.grid2 {
					grid-template-columns: 1fr;
				}
			}
			.panel {
				background: var(--panel);
				border: 1px solid var(--line);
				border-radius: 10px;
				padding: 18px;
			}
			.panel h2 {
				font-size: 14px;
				margin: 0 0 14px;
				text-transform: uppercase;
				letter-spacing: 0.5px;
				color: var(--muted);
			}
			.chart {
				display: flex;
				gap: 18px;
				align-items: center;
			}
			.chart svg {
				flex: 0 0 auto;
			}
			.slice {
				cursor: pointer;
				transition: opacity 0.15s;
			}
			.slice:hover {
				opacity: 0.85;
			}
			.legend {
				display: flex;
				flex-direction: column;
				gap: 8px;
				font-size: 13px;
			}
			.legend .item {
				display: flex;
				align-items: center;
				gap: 8px;
				cursor: pointer;
				padding: 3px 6px;
				border-radius: 6px;
			}
			.legend .item:hover {
				background: var(--panel-2);
			}
			.legend .item.active {
				background: var(--panel-2);
				outline: 1px solid var(--accent);
			}
			.legend .swatch {
				width: 11px;
				height: 11px;
				border-radius: 3px;
				flex: 0 0 auto;
			}
			.legend .count {
				color: var(--muted);
				margin-left: auto;
			}
			.controls {
				display: flex;
				gap: 8px;
				align-items: center;
				margin-bottom: 14px;
				flex-wrap: wrap;
			}
			.chip {
				background: var(--panel-2);
				border: 1px solid var(--line);
				color: var(--muted);
				border-radius: 20px;
				padding: 6px 12px;
				font-size: 12px;
				cursor: pointer;
			}
			.chip:hover {
				color: var(--text);
			}
			.chip.active {
				background: var(--accent);
				border-color: var(--accent);
				color: #06231f;
				font-weight: 600;
			}
			input[type='search'] {
				background: var(--panel-2);
				border: 1px solid var(--line);
				color: var(--text);
				border-radius: 8px;
				padding: 8px 10px;
				font-size: 13px;
				flex: 1;
				min-width: 200px;
			}
			table {
				width: 100%;
				border-collapse: collapse;
				font-size: 13px;
			}
			th,
			td {
				text-align: left;
				padding: 8px 10px;
				border-bottom: 1px solid var(--line);
			}
			th {
				color: var(--muted);
				font-weight: 600;
				cursor: pointer;
				user-select: none;
				white-space: nowrap;
			}
			th.num,
			td.num {
				text-align: right;
			}
			tbody tr:hover {
				background: var(--panel-2);
			}
			.tag {
				display: inline-block;
				padding: 2px 8px;
				border-radius: 20px;
				font-size: 11px;
				font-weight: 600;
			}
			.tag.page {
				background: rgba(9, 179, 175, 0.15);
				color: var(--page);
			}
			.tag.nested {
				background: rgba(240, 160, 32, 0.15);
				color: var(--nested);
			}
			.tag.universal {
				background: rgba(126, 140, 255, 0.18);
				color: var(--universal);
			}
			.tag.unclassified {
				background: rgba(154, 161, 177, 0.15);
				color: var(--muted);
			}
			.dot {
				display: inline-block;
				width: 9px;
				height: 9px;
				border-radius: 50%;
			}
			.dot.yes {
				background: var(--good);
			}
			.dot.no {
				background: #3a3f4d;
			}
			.zero {
				color: var(--bad);
				font-weight: 600;
			}
			.rowcount {
				color: var(--muted);
				font-size: 12px;
				margin-left: auto;
			}
		</style>
	</head>
	<body>
		<h1>Storyblok space health</h1>
		<div class="sub" id="subtitle">Loading...</div>
		<div class="sourcebar">
			<button id="btn-static">Static snapshot</button>
			<button id="btn-live">Refresh live from Storyblok</button>
		</div>
		<div class="state" id="state">Loading component insights...</div>
		<div id="dashboard" style="display: none">
			<div class="cards" id="cards"></div>
			<div class="grid2">
				<div class="panel">
					<h2>Component types</h2>
					<div class="chart">
						<div id="pie-types"></div><div class="legend" id="legend-types"></div>
					</div>
				</div>
				<div class="panel">
					<h2>Usage</h2>
					<div class="chart">
						<div id="pie-usage"></div><div class="legend" id="legend-usage"></div>
					</div>
				</div>
			</div>
			<div class="panel">
				<h2>Components</h2>
				<div class="controls" id="chips"></div>
				<div class="controls">
					<input type="search" id="search" placeholder="Filter by name..." />
					<span class="rowcount" id="rowcount"></span>
				</div>
				<table>
					<thead>
						<tr>
							<th data-sort="name">Component</th>
							<th data-sort="classification">Type</th>
							<th class="num" data-sort="pageSectionUsage">In page</th>
							<th class="num" data-sort="totalUsage">Total</th>
							<th class="num" data-sort="asRootUsage">As page</th>
							<th class="num" data-sort="nestedUsage">Nested</th>
							<th class="num" data-sort="storyCount">Stories</th>
							<th>Icon</th>
							<th>Color</th>
							<th>Preview</th>
						</tr>
					</thead>
					<tbody id="rows"></tbody>
				</table>
			</div>
		</div>

		<script is:inline define:vars={{ staticData, liveEndpoint }}>
			let REPORT = null;
			let activeFilter = 'page-section';
			let sortKey = 'pageSectionUsage';
			let sortDir = -1;

			const COLORS = {
				page: '#09b3af',
				nested: '#f0a020',
				universal: '#7e8cff',
				unclassified: '#6b7280',
				used: '#4caf7d',
				unused: '#e2526b',
			};

			const CHIPS = [
				{ id: 'page-section', label: 'In page components' },
				{ id: 'all', label: 'All' },
				{ id: 'page', label: 'Page' },
				{ id: 'nested', label: 'Nested' },
				{ id: 'universal', label: 'Universal' },
				{ id: 'unclassified', label: 'Unclassified' },
				{ id: 'used', label: 'Used' },
				{ id: 'unused', label: 'Unused' },
				{ id: 'no-icon', label: 'Missing icon' },
				{ id: 'no-color', label: 'Missing color' },
				{ id: 'no-preview', label: 'Missing preview' },
			];

			const escapeHtml = value =>
				String(value).replace(
					/[&<>"]/g,
					ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[ch]
				);

			function predicate(component, mode) {
				switch (mode) {
					case 'page-section':
						return component.pageSectionUsage > 0;
					case 'page':
					case 'nested':
					case 'universal':
					case 'unclassified':
						return component.classification === mode;
					case 'used':
						return component.totalUsage > 0;
					case 'unused':
						return component.totalUsage === 0;
					case 'no-icon':
						return !component.hasIcon;
					case 'no-color':
						return !component.hasColor;
					case 'no-preview':
						return !component.hasPreview;
					default:
						return true;
				}
			}

			function setFilter(mode) {
				activeFilter = mode;
				renderChips();
				renderLegendActive();
				renderTable();
			}

			function dot(on) {
				return '<span class="dot ' + (on ? 'yes' : 'no') + '"></span>';
			}

			function renderChips() {
				document.getElementById('chips').innerHTML = CHIPS.map(
					chip =>
						'<span class="chip ' +
						(activeFilter === chip.id ? 'active' : '') +
						'" data-filter="' +
						chip.id +
						'">' +
						chip.label +
						'</span>'
				).join('');
				document.querySelectorAll('.chip').forEach(chip => {
					chip.addEventListener('click', () =>
						setFilter(chip.getAttribute('data-filter'))
					);
				});
			}

			function arcPath(cx, cy, radius, startAngle, endAngle) {
				const toXy = angle => [
					cx + radius * Math.cos(angle),
					cy + radius * Math.sin(angle),
				];
				const [x1, y1] = toXy(startAngle);
				const [x2, y2] = toXy(endAngle);
				const large = endAngle - startAngle > Math.PI ? 1 : 0;
				return (
					'M ' +
					cx +
					' ' +
					cy +
					' L ' +
					x1 +
					' ' +
					y1 +
					' A ' +
					radius +
					' ' +
					radius +
					' 0 ' +
					large +
					' 1 ' +
					x2 +
					' ' +
					y2 +
					' Z'
				);
			}

			function renderPie(containerId, legendId, segments) {
				const total = segments.reduce((sum, seg) => sum + seg.value, 0) || 1;
				const size = 150;
				const cx = size / 2;
				const cy = size / 2;
				const radius = size / 2 - 2;
				let angle = -Math.PI / 2;
				const paths = segments
					.filter(seg => seg.value > 0)
					.map(seg => {
						const start = angle;
						const end = angle + (seg.value / total) * Math.PI * 2;
						angle = end;
						return (
							'<path class="slice" data-filter="' +
							seg.filter +
							'" d="' +
							arcPath(cx, cy, radius, start, end) +
							'" fill="' +
							seg.color +
							'"><title>' +
							seg.label +
							': ' +
							seg.value +
							'</title></path>'
						);
					})
					.join('');
				document.getElementById(containerId).innerHTML =
					'<svg width="' +
					size +
					'" height="' +
					size +
					'" viewBox="0 0 ' +
					size +
					' ' +
					size +
					'">' +
					paths +
					'<circle cx="' +
					cx +
					'" cy="' +
					cy +
					'" r="' +
					radius * 0.55 +
					'" fill="#171a22"></circle>' +
					'<text x="' +
					cx +
					'" y="' +
					(cy + 5) +
					'" text-anchor="middle" fill="#e6e8ee" font-size="20" font-weight="700">' +
					total +
					'</text></svg>';

				document.getElementById(legendId).innerHTML = segments
					.map(
						seg =>
							'<div class="item" data-filter="' +
							seg.filter +
							'"><span class="swatch" style="background:' +
							seg.color +
							'"></span>' +
							seg.label +
							'<span class="count">' +
							seg.value +
							'</span></div>'
					)
					.join('');

				document
					.querySelectorAll('#' + containerId + ' .slice, #' + legendId + ' .item')
					.forEach(el => {
						el.addEventListener('click', () =>
							setFilter(el.getAttribute('data-filter'))
						);
					});
			}

			function renderLegendActive() {
				document.querySelectorAll('.legend .item').forEach(item => {
					item.classList.toggle(
						'active',
						item.getAttribute('data-filter') === activeFilter
					);
				});
			}

			function renderTable() {
				const term = document.getElementById('search').value.toLowerCase();
				const rows = REPORT.components
					.filter(c => c.name.toLowerCase().includes(term) && predicate(c, activeFilter))
					.sort((a, b) => {
						const av = a[sortKey];
						const bv = b[sortKey];
						if (typeof av === 'string') return av.localeCompare(bv) * sortDir;
						return (av - bv) * sortDir;
					});
				document.getElementById('rowcount').textContent =
					rows.length + ' of ' + REPORT.components.length + ' components';
				document.getElementById('rows').innerHTML = rows
					.map(
						c =>
							'<tr>' +
							'<td>' +
							escapeHtml(c.name) +
							'</td>' +
							'<td><span class="tag ' +
							c.classification +
							'">' +
							c.classification +
							'</span></td>' +
							'<td class="num">' +
							c.pageSectionUsage +
							'</td>' +
							'<td class="num ' +
							(c.totalUsage === 0 ? 'zero' : '') +
							'">' +
							c.totalUsage +
							'</td>' +
							'<td class="num">' +
							c.asRootUsage +
							'</td>' +
							'<td class="num">' +
							c.nestedUsage +
							'</td>' +
							'<td class="num">' +
							c.storyCount +
							'</td>' +
							'<td>' +
							dot(c.hasIcon) +
							'</td>' +
							'<td>' +
							dot(c.hasColor) +
							'</td>' +
							'<td>' +
							dot(c.hasPreview) +
							'</td>' +
							'</tr>'
					)
					.join('');
			}

			function render() {
				const s = REPORT.summary;
				document.getElementById('subtitle').textContent =
					'Space ' +
					REPORT.spaceId +
					' · ' +
					REPORT.storiesAnalysed +
					' stories · ' +
					REPORT.contentVersion;

				const cards = [
					{ num: s.totalComponents, lbl: 'Components' },
					{ num: s.pageSectionComponents, lbl: 'In page array' },
					{ num: s.pageComponents, lbl: 'Page' },
					{ num: s.nestedComponents, lbl: 'Nested' },
					{ num: s.universalComponents, lbl: 'Universal' },
					{ num: s.usedComponents, lbl: 'Used' },
					{ num: s.unusedComponents, lbl: 'Unused' },
					{ num: s.withIcon, lbl: 'With icon' },
					{ num: s.withColor, lbl: 'With color' },
					{ num: s.withPreview, lbl: 'With preview' },
				];
				document.getElementById('cards').innerHTML = cards
					.map(
						c =>
							'<div class="card"><div class="num">' +
							c.num +
							'</div><div class="lbl">' +
							c.lbl +
							'</div></div>'
					)
					.join('');

				renderPie('pie-types', 'legend-types', [
					{ label: 'Page', value: s.pageComponents, color: COLORS.page, filter: 'page' },
					{
						label: 'Nested',
						value: s.nestedComponents,
						color: COLORS.nested,
						filter: 'nested',
					},
					{
						label: 'Universal',
						value: s.universalComponents,
						color: COLORS.universal,
						filter: 'universal',
					},
					{
						label: 'Unclassified',
						value: s.unclassifiedComponents,
						color: COLORS.unclassified,
						filter: 'unclassified',
					},
				]);
				renderPie('pie-usage', 'legend-usage', [
					{ label: 'Used', value: s.usedComponents, color: COLORS.used, filter: 'used' },
					{
						label: 'Unused',
						value: s.unusedComponents,
						color: COLORS.unused,
						filter: 'unused',
					},
				]);

				renderChips();
				renderLegendActive();

				document.querySelectorAll('th[data-sort]').forEach(th => {
					th.addEventListener('click', () => {
						const key = th.getAttribute('data-sort');
						if (sortKey === key) sortDir *= -1;
						else {
							sortKey = key;
							sortDir = typeof REPORT.components[0][key] === 'string' ? 1 : -1;
						}
						renderTable();
					});
				});
				document.getElementById('search').addEventListener('input', renderTable);

				document.getElementById('state').style.display = 'none';
				document.getElementById('dashboard').style.display = 'block';
				renderTable();
			}

			async function load(source, label) {
				const state = document.getElementById('state');
				document.getElementById('dashboard').style.display = 'none';
				state.className = 'state';
				state.style.display = 'block';
				state.textContent = 'Loading ' + label + '...';
				try {
					const response = await fetch(source);
					const body = await response.json();
					if (!response.ok)
						throw new Error(body.error || 'Request failed (' + response.status + ')');
					REPORT = body;
					render();
				} catch (error) {
					state.className = 'state error';
					state.textContent = 'Failed to load ' + label + ': ' + error.message;
					document.getElementById('subtitle').textContent = '';
				}
			}

			document
				.getElementById('btn-static')
				.addEventListener('click', () => load(staticData, 'static snapshot'));
			document
				.getElementById('btn-live')
				.addEventListener('click', () => load(liveEndpoint, 'live data'));

			load(staticData, 'static snapshot');
		</script>
	</body>
</html>
