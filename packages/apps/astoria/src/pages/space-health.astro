---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>LightBlok — Storyblok UX optimization</title>
		<style is:global>
			:root {
				--ink: #1b243f;
				--teal: #09b3af;
				--green: #4caf7d;
				--amber: #f0a020;
				--red: #e2526b;
				--bg: #f3f5fb;
				--card: #ffffff;
				--line: #e6e9f2;
				--muted: #7a829b;
			}
			* {
				box-sizing: border-box;
			}
			body {
				margin: 0;
				background: var(--bg);
				color: var(--ink);
				font-family:
					ui-sans-serif,
					system-ui,
					-apple-system,
					'Segoe UI',
					Roboto,
					sans-serif;
			}
			.bar {
				background: linear-gradient(100deg, var(--ink), #2a3556);
				color: #fff;
				padding: 26px 32px;
			}
			.bar h1 {
				margin: 0;
				font-size: 24px;
				font-weight: 800;
				letter-spacing: -0.4px;
				display: flex;
				align-items: center;
				gap: 10px;
			}
			.bar .logo {
				width: 28px;
				height: 28px;
				border-radius: 8px;
				background: var(--teal);
				display: inline-flex;
				align-items: center;
				justify-content: center;
				font-weight: 900;
				color: #06231f;
			}
			.bar p {
				margin: 6px 0 0;
				color: #b9c0d6;
				font-size: 14px;
			}
			.bar .tagline {
				color: #fff;
				font-weight: 600;
				font-size: 14px;
				margin-top: 8px;
			}
			.bar #subtitle {
				font-size: 13px;
			}
			.cats {
				display: flex;
				flex-direction: column;
				gap: 8px;
				margin-top: 14px;
				width: 100%;
			}
			.cat {
				display: grid;
				grid-template-columns: 92px 1fr 38px;
				align-items: center;
				gap: 8px;
				font-size: 12px;
			}
			.cat .cname {
				color: var(--muted);
				font-weight: 700;
			}
			.cat .ctrack {
				height: 6px;
				border-radius: 4px;
				background: #eef0f7;
				overflow: hidden;
			}
			.cat .ctrack span {
				display: block;
				height: 100%;
			}
			.cat .cval {
				text-align: right;
				font-weight: 700;
				font-variant-numeric: tabular-nums;
			}
			.bar .sourcebar {
				margin-top: 14px;
				display: flex;
				gap: 8px;
				flex-wrap: wrap;
			}
			.bar button {
				background: rgba(255, 255, 255, 0.1);
				border: 1px solid rgba(255, 255, 255, 0.2);
				color: #fff;
				border-radius: 8px;
				padding: 7px 13px;
				font: inherit;
				font-size: 13px;
				cursor: pointer;
			}
			.bar button:hover {
				background: rgba(255, 255, 255, 0.18);
			}
			.wrap {
				max-width: 1180px;
				margin: -18px auto 48px;
				padding: 0 24px;
			}
			.state {
				color: var(--muted);
				padding: 30px 4px;
			}
			.state.error {
				color: var(--red);
			}
			.cards {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
				gap: 14px;
				margin-bottom: 16px;
			}
			.card {
				background: var(--card);
				border-radius: 16px;
				padding: 18px;
				box-shadow: 0 6px 20px rgba(27, 36, 63, 0.06);
			}
			.card .num {
				font-size: 30px;
				font-weight: 800;
			}
			.card .lbl {
				font-size: 12px;
				color: var(--muted);
				margin-top: 4px;
				font-weight: 600;
			}
			.panel {
				background: var(--card);
				border-radius: 16px;
				padding: 20px;
				box-shadow: 0 6px 20px rgba(27, 36, 63, 0.06);
			}
			.panel h2 {
				font-size: 13px;
				text-transform: uppercase;
				letter-spacing: 1px;
				color: var(--muted);
				margin: 0 0 16px;
			}
			.healthrow {
				display: grid;
				grid-template-columns: 230px 1fr;
				gap: 24px;
				align-items: center;
			}
			@media (max-width: 760px) {
				.healthrow {
					grid-template-columns: 1fr;
				}
			}
			.gauge {
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
			}
			.gauge .label {
				font-size: 12px;
				color: var(--muted);
				font-weight: 600;
				text-transform: uppercase;
				letter-spacing: 1px;
				margin-top: 2px;
			}
			.healthpanel {
				margin-bottom: 16px;
			}
			.tiles {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
				gap: 14px;
			}
			.tile {
				border: 1px solid var(--line);
				border-radius: 14px;
				padding: 16px;
				background: #fff;
				display: flex;
				flex-direction: column;
				gap: 8px;
			}
			.tile .head {
				display: flex;
				align-items: center;
				gap: 10px;
			}
			.tile .emoji {
				font-size: 26px;
				line-height: 1;
				width: 44px;
				height: 44px;
				border-radius: 12px;
				display: inline-flex;
				align-items: center;
				justify-content: center;
				flex: 0 0 auto;
			}
			.tile .title {
				font-size: 15px;
				font-weight: 800;
			}
			.tile .pct {
				margin-left: auto;
				font-size: 18px;
				font-weight: 800;
				font-variant-numeric: tabular-nums;
			}
			.tile .desc {
				font-size: 12.5px;
				color: var(--muted);
				line-height: 1.45;
				min-height: 36px;
			}
			.tile .bar {
				height: 7px;
				border-radius: 4px;
				background: #eef0f7;
				overflow: hidden;
			}
			.tile .bar span {
				display: block;
				height: 100%;
			}
			.tile .meta {
				display: flex;
				align-items: center;
				gap: 8px;
				font-size: 12px;
				color: var(--muted);
				font-variant-numeric: tabular-nums;
			}
			.tile .fix {
				margin-top: 2px;
				border: none;
				border-radius: 10px;
				padding: 10px 12px;
				font: inherit;
				font-size: 13px;
				font-weight: 700;
				cursor: pointer;
				color: #fff;
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 8px;
			}
			.tile .fix:hover {
				filter: brightness(1.06);
			}
			.tile.done .fix {
				background: #e9ecf4 !important;
				color: var(--muted);
				cursor: default;
			}
			.panels {
				display: grid;
				grid-template-columns: 340px 1fr;
				gap: 16px;
				align-items: start;
			}
			@media (max-width: 880px) {
				.panels {
					grid-template-columns: 1fr;
				}
			}
			.donutwrap {
				display: flex;
				align-items: center;
				gap: 18px;
			}
			.leg {
				display: flex;
				flex-direction: column;
				gap: 9px;
				font-size: 13px;
				flex: 1;
			}
			.leg .r {
				display: flex;
				align-items: center;
				gap: 8px;
				cursor: pointer;
				padding: 3px 5px;
				border-radius: 7px;
			}
			.leg .r:hover {
				background: #f3f5fb;
			}
			.leg .r.active {
				background: #eaf6f5;
				outline: 1px solid var(--teal);
			}
			.leg .sw {
				width: 12px;
				height: 12px;
				border-radius: 4px;
				flex: 0 0 auto;
			}
			.leg b {
				font-variant-numeric: tabular-nums;
			}
			.leg .m {
				color: var(--muted);
			}
			.chips {
				display: flex;
				gap: 8px;
				flex-wrap: wrap;
				margin-bottom: 14px;
			}
			.chips button {
				border: none;
				background: #eef0f7;
				color: var(--ink);
				border-radius: 999px;
				padding: 9px 16px;
				font: inherit;
				font-size: 13px;
				font-weight: 600;
				cursor: pointer;
			}
			.chips button:hover {
				background: #e3e7f2;
			}
			.chips button.on {
				background: var(--teal);
				color: #06231f;
			}
			.tablewrap {
				max-height: 620px;
				overflow: auto;
			}
			table {
				width: 100%;
				border-collapse: separate;
				border-spacing: 0;
				font-size: 14px;
			}
			th {
				text-align: left;
				color: var(--muted);
				font-size: 12px;
				text-transform: uppercase;
				letter-spacing: 0.5px;
				padding: 10px 12px;
				cursor: pointer;
				user-select: none;
				white-space: nowrap;
				position: sticky;
				top: 0;
				background: var(--card);
			}
			td {
				padding: 11px 12px;
				border-top: 1px solid var(--line);
				vertical-align: middle;
			}
			tbody tr:hover td {
				background: #f7f9ff;
			}
			.comp {
				font-weight: 700;
			}
			.num {
				text-align: left;
				font-variant-numeric: tabular-nums;
				font-weight: 600;
			}
			.zero {
				color: var(--red);
			}
			.pill {
				display: inline-block;
				padding: 3px 10px;
				border-radius: 999px;
				font-size: 12px;
				font-weight: 700;
				text-transform: capitalize;
			}
			.icon-badge {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				width: 34px;
				height: 34px;
				border-radius: 8px;
				flex: 0 0 auto;
			}
			.icon-badge.empty {
				background: #eef0f7;
			}
			.dot {
				display: inline-block;
				width: 9px;
				height: 9px;
				border-radius: 50%;
			}
			.rowcount {
				color: var(--muted);
				font-size: 12px;
				margin: 0 0 10px;
			}
			.search {
				background: #f3f5fb;
				border: 1px solid var(--line);
				color: var(--ink);
				border-radius: 10px;
				padding: 9px 12px;
				font: inherit;
				font-size: 13px;
				width: 100%;
				margin-bottom: 12px;
			}
			.overlay {
				position: fixed;
				inset: 0;
				background: rgba(15, 19, 30, 0.55);
				display: none;
				align-items: center;
				justify-content: center;
				padding: 24px;
				z-index: 50;
			}
			.overlay.open {
				display: flex;
			}
			.modal {
				background: #fff;
				border-radius: 18px;
				width: 560px;
				max-width: 100%;
				max-height: 86vh;
				overflow: auto;
				box-shadow: 0 20px 60px rgba(15, 19, 30, 0.4);
			}
			.modal .mhead {
				display: flex;
				align-items: center;
				gap: 12px;
				padding: 22px 24px 8px;
			}
			.modal .mhead .emoji {
				font-size: 26px;
				width: 46px;
				height: 46px;
				border-radius: 12px;
				display: inline-flex;
				align-items: center;
				justify-content: center;
				flex: 0 0 auto;
			}
			.modal .mhead h3 {
				margin: 0;
				font-size: 18px;
				font-weight: 800;
			}
			.modal .mhead p {
				margin: 2px 0 0;
				font-size: 13px;
				color: var(--muted);
			}
			.modal .mclose {
				margin-left: auto;
				border: none;
				background: #eef0f7;
				width: 32px;
				height: 32px;
				border-radius: 9px;
				font-size: 16px;
				cursor: pointer;
				color: var(--muted);
			}
			.steps {
				display: flex;
				gap: 8px;
				padding: 16px 24px;
			}
			.step {
				flex: 1;
				border: 1px solid var(--line);
				border-radius: 10px;
				padding: 10px;
				font-size: 12px;
				text-align: center;
				color: var(--muted);
			}
			.step .n {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				width: 20px;
				height: 20px;
				border-radius: 50%;
				background: #eef0f7;
				font-weight: 800;
				margin-bottom: 6px;
			}
			.step.done {
				border-color: var(--green);
				color: var(--ink);
			}
			.step.done .n {
				background: var(--green);
				color: #fff;
			}
			.step.next {
				border-color: var(--teal);
				color: var(--ink);
			}
			.step.next .n {
				background: var(--teal);
				color: #06231f;
			}
			.affected {
				padding: 0 24px;
			}
			.affected h4 {
				font-size: 12px;
				text-transform: uppercase;
				letter-spacing: 0.5px;
				color: var(--muted);
				margin: 4px 0 8px;
			}
			.chiplist {
				display: flex;
				flex-wrap: wrap;
				gap: 6px;
			}
			.chiplist span {
				background: #f3f5fb;
				border: 1px solid var(--line);
				border-radius: 8px;
				padding: 4px 8px;
				font-size: 12px;
			}
			.chiplist button.shot {
				background: #f3f5fb;
				border: 1px solid var(--line);
				border-radius: 8px;
				padding: 4px 8px;
				font: inherit;
				font-size: 12px;
				cursor: pointer;
			}
			.chiplist button.shot:hover {
				border-color: var(--teal);
			}
			.chiplist button.shot:disabled {
				cursor: default;
			}
			.mfoot {
				display: flex;
				gap: 10px;
				align-items: center;
				padding: 18px 24px 24px;
			}
			.mfoot .note {
				font-size: 12px;
				color: var(--muted);
				flex: 1;
			}
			.mfoot .ghost {
				border: 1px solid var(--line);
				background: #fff;
				color: var(--ink);
				border-radius: 10px;
				padding: 10px 14px;
				font: inherit;
				font-weight: 700;
				font-size: 13px;
				cursor: pointer;
			}
			.mfoot .primary {
				border: none;
				background: var(--teal);
				color: #06231f;
				border-radius: 10px;
				padding: 10px 16px;
				font: inherit;
				font-weight: 800;
				font-size: 13px;
				cursor: pointer;
			}
			.mfoot .primary:disabled {
				opacity: 0.55;
				cursor: not-allowed;
			}
		</style>
	</head>
	<body>
		<div class="bar">
			<h1>
				<span class="logo"
					><svg
						viewBox="0 0 24 24"
						width="18"
						height="18"
						fill="#06231f"
						aria-hidden="true"
						><path
							d="M8 10V8h1V4H8V3l4-2l4 2v1h-1v4h1v2h-1.26l-6.3 3.64L9 10zm5-2V4h-2v4zM7 23l.04-.24l9.11-5.26l.52 3.38L13 23zm1.05-6.83L15.31 12l.52 3.37l-8.4 4.85z"
						></path></svg
					></span
				> LightBlok
			</h1>
			<p class="tagline">Storyblok UX optimization — get the most out of Storyblok</p>
			<p id="subtitle">Loading component insights…</p>
			<div class="sourcebar">
				<button id="btn-static">Static snapshot</button>
				<button id="btn-live">Refresh live from Storyblok</button>
			</div>
		</div>
		<div class="wrap">
			<div class="state" id="state">Loading…</div>
			<div id="dashboard" style="display: none">
				<div class="cards" id="cards"></div>
				<div class="panel healthpanel">
					<h2>Setup coverage &amp; quick wins</h2>
					<div class="healthrow">
						<div class="gauge">
							<div id="gauge"></div>
							<div class="cats" id="cats"></div>
						</div>
						<div class="tiles" id="tiles"></div>
					</div>
				</div>
				<div class="panels">
					<div class="panel">
						<h2>Component role</h2>
						<div class="donutwrap">
							<div id="donut"></div><div class="leg" id="leg"></div>
						</div>
					</div>
					<div class="panel">
						<h2>Components</h2>
						<div class="chips" id="chips"></div>
						<input
							type="search"
							class="search"
							id="search"
							placeholder="Filter by name…"
						/>
						<div class="rowcount" id="rowcount"></div>
						<div class="tablewrap">
							<table>
								<thead>
									<tr>
										<th data-sort="name">Component</th>
										<th data-sort="role">Role</th>
										<th data-sort="classification">Type</th>
										<th class="num" data-sort="pageSectionUsage">In page</th>
										<th class="num" data-sort="totalUsage">Total</th>
										<th class="num" data-sort="nestedUsage">Nested</th>
										<th class="num" data-sort="storyCount">Stories</th>
										<th data-sort="icon">Icon</th>
										<th>Preview</th>
										<th>Preset</th>
									</tr>
								</thead>
								<tbody id="rows"></tbody>
							</table>
						</div>
					</div>
				</div>
			</div>
		</div>

		<div class="overlay" id="wizard">
			<div class="modal">
				<div class="mhead">
					<span class="emoji" id="wz-emoji"></span>
					<div>
						<h3 id="wz-title"></h3>
						<p id="wz-sub"></p>
					</div>
					<button class="mclose" id="wz-close">✕</button>
				</div>
				<div class="steps">
					<div class="step done"><div class="n">1</div>Detect</div>
					<div class="step next"><div class="n">2</div>AI proposal</div>
					<div class="step"><div class="n">3</div>Review</div>
					<div class="step"><div class="n">4</div>Apply</div>
				</div>
				<div class="affected">
					<h4 id="wz-affected-label">Affected</h4>
					<div class="chiplist" id="wz-affected"></div>
				</div>
				<div class="mfoot">
					<span class="note" id="wz-note"></span>
					<button class="ghost" id="wz-filter">Show in table</button>
					<button class="primary" id="wz-start" disabled>Generate AI proposals</button>
				</div>
			</div>
		</div>

		<script is:inline define:vars={{ staticData, liveEndpoint, iconSvg }}>
			let REPORT = null;
			let activeFilter = 'in-page';
			let sortKey = 'pageSectionUsage';
			let sortDir = -1;

			const ICON_SVG = iconSvg;
			const RC = {
				page: '#09b3af',
				section: '#4caf7d',
				subcomponent: '#f0a020',
				unused: '#e2526b',
			};

			const TILE_DEFS = [
				{
					id: 'icon',
					emoji: '🎨',
					label: 'Icons',
					cat: 'Schema',
					bad: c => !c.hasIcon,
					filter: 'no-icon',
					desc: 'Block icons make the component picker scannable for editors.',
				},
				{
					id: 'color',
					emoji: '🌈',
					label: 'Colors',
					cat: 'Schema',
					bad: c => !c.hasColor,
					filter: 'no-color',
					desc: 'Brand colors group related blocks at a glance in the library.',
				},
				{
					id: 'preview',
					emoji: '📷',
					label: 'Previews',
					cat: 'Schema',
					bad: c => !c.hasPreview,
					filter: 'no-preview',
					desc: 'Preview images show editors what a block looks like before inserting.',
				},
				{
					id: 'preset',
					emoji: '🧩',
					label: 'Presets',
					cat: 'Schema',
					bad: c => !c.hasPreset,
					filter: 'no-preset',
					desc: 'Presets give editors ready-made starting points for a block.',
				},
				{
					id: 'seo',
					emoji: '🔍',
					label: 'SEO',
					cat: 'SEO',
					seo: true,
					filter: null,
					desc: 'Meta title and description drive search ranking and social sharing.',
				},
				{
					id: 'scoped',
					emoji: '🌐',
					label: 'Scoped',
					cat: 'Hygiene',
					bad: c => c.classification === 'universal',
					filter: 'universal',
					review: true,
					desc: 'Components allowed everywhere are hard to govern — scope them to where they belong.',
				},
				{
					id: 'used',
					emoji: '🗑️',
					label: 'Unused',
					cat: 'Hygiene',
					bad: c => c.totalUsage === 0,
					filter: 'unused',
					review: true,
					desc: 'Unused components clutter the library — review them for cleanup.',
				},
			];

			const CATEGORIES = [
				{ key: 'Schema', signals: ['icon', 'color', 'preview', 'preset'] },
				{ key: 'Content', adoption: true },
				{ key: 'SEO', signals: ['seo'] },
				{ key: 'Hygiene', signals: ['scoped'] },
			];

			const CHIPS = [
				{ id: 'in-page', label: 'In page' },
				{ id: 'all', label: 'All' },
				{ id: 'role:page', label: 'Page' },
				{ id: 'role:section', label: 'Section' },
				{ id: 'role:subcomponent', label: 'Subcomponent' },
				{ id: 'role:unused', label: 'Unused' },
				{ id: 'no-icon', label: 'Missing icon' },
				{ id: 'no-color', label: 'Missing color' },
				{ id: 'no-preview', label: 'Missing preview' },
				{ id: 'no-preset', label: 'Missing preset' },
			];

			const escapeHtml = value =>
				String(value).replace(
					/[&<>"]/g,
					ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[ch]
				);

			function predicate(c, mode) {
				if (mode === 'all') return true;
				if (mode === 'in-page') return c.pageSectionUsage > 0;
				if (mode === 'used') return c.totalUsage > 0;
				if (mode === 'unused') return c.totalUsage === 0;
				if (mode === 'no-icon') return !c.hasIcon;
				if (mode === 'no-color') return !c.hasColor;
				if (mode === 'no-preview') return !c.hasPreview;
				if (mode === 'no-preset') return !c.hasPreset;
				if (mode === 'universal') return c.classification === 'universal';
				if (mode.startsWith('role:')) return c.role === mode.slice(5);
				return true;
			}

			function setFilter(mode) {
				activeFilter = mode;
				renderChips();
				renderActive();
				renderTable();
			}

			function severity(pct) {
				return pct >= 80 ? '#4caf7d' : pct >= 40 ? '#f0a020' : '#e2526b';
			}

			function severityWord(pct) {
				return pct >= 80
					? 'Well configured'
					: pct >= 40
						? 'Room to grow'
						: 'Lots of upside';
			}

			function isLight(hex) {
				const match = /^#([0-9a-f]{6})$/i.exec(hex || '');
				if (!match) return false;
				const int = parseInt(match[1], 16);
				const r = (int >> 16) & 255;
				const g = (int >> 8) & 255;
				const b = int & 255;
				return (0.299 * r + 0.587 * g + 0.114 * b) / 255 > 0.62;
			}

			function iconGlyph(name, color) {
				const body = ICON_SVG[name];
				if (!body) return '';
				return (
					'<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="' +
					color +
					'" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' +
					body +
					'</svg>'
				);
			}

			function iconBadge(c) {
				if (!c.icon && !c.color) return '<span class="icon-badge empty"></span>';
				const bg = c.color && /^#[0-9a-f]{6}$/i.test(c.color) ? c.color : '#eef0f7';
				const fg = isLight(bg) ? '#10131a' : '#ffffff';
				return (
					'<span class="icon-badge" style="background:' +
					bg +
					'" title="' +
					escapeHtml((c.icon || 'no icon') + (c.color ? ' · ' + c.color : '')) +
					'">' +
					(c.icon ? iconGlyph(c.icon, fg) : '') +
					'</span>'
				);
			}

			function dot(on) {
				return (
					'<span class="dot" style="background:' +
					(on ? '#4caf7d' : '#dfe3ee') +
					'"></span>'
				);
			}

			function renderChips() {
				document.getElementById('chips').innerHTML = CHIPS.map(
					chip =>
						'<button class="' +
						(activeFilter === chip.id ? 'on' : '') +
						'" data-filter="' +
						chip.id +
						'">' +
						chip.label +
						'</button>'
				).join('');
				document
					.querySelectorAll('.chips button')
					.forEach(b =>
						b.addEventListener('click', () => setFilter(b.getAttribute('data-filter')))
					);
			}

			function polar(cx, cy, r, angle) {
				return [cx + r * Math.cos(angle), cy + r * Math.sin(angle)];
			}

			function arcStroke(cx, cy, r, a0, a1) {
				const [x0, y0] = polar(cx, cy, r, a0);
				const [x1, y1] = polar(cx, cy, r, a1);
				const large = a1 - a0 > Math.PI ? 1 : 0;
				return (
					'M ' +
					x0 +
					' ' +
					y0 +
					' A ' +
					r +
					' ' +
					r +
					' 0 ' +
					large +
					' 1 ' +
					x1 +
					' ' +
					y1
				);
			}

			function gauge(pct) {
				const w = 200;
				const h = 128;
				const cx = w / 2;
				const cy = 112;
				const r = 88;
				const start = Math.PI;
				const end = Math.PI * 2;
				const value = start + (end - start) * (pct / 100);
				const color = severity(pct);
				return (
					'<svg width="' +
					w +
					'" height="' +
					h +
					'" viewBox="0 0 ' +
					w +
					' ' +
					h +
					'">' +
					'<path d="' +
					arcStroke(cx, cy, r, start, end) +
					'" fill="none" stroke="#eef0f7" stroke-width="16" stroke-linecap="round" />' +
					'<path d="' +
					arcStroke(cx, cy, r, start, value) +
					'" fill="none" stroke="' +
					color +
					'" stroke-width="16" stroke-linecap="round" />' +
					'<text x="' +
					cx +
					'" y="' +
					(cy - 18) +
					'" text-anchor="middle" fill="#1b243f" font-size="44" font-weight="800">' +
					pct +
					'</text>' +
					'<text x="' +
					cx +
					'" y="' +
					(cy + 4) +
					'" text-anchor="middle" fill="' +
					color +
					'" font-size="13" font-weight="800">' +
					severityWord(pct) +
					'</text>' +
					'</svg>'
				);
			}

			function arcWedge(cx, cy, r, a0, a1) {
				const [x0, y0] = polar(cx, cy, r, a0);
				const [x1, y1] = polar(cx, cy, r, a1);
				const large = a1 - a0 > Math.PI ? 1 : 0;
				return (
					'M ' +
					cx +
					' ' +
					cy +
					' L ' +
					x0 +
					' ' +
					y0 +
					' A ' +
					r +
					' ' +
					r +
					' 0 ' +
					large +
					' 1 ' +
					x1 +
					' ' +
					y1 +
					' Z'
				);
			}

			function donut(segments, size) {
				const total = segments.reduce((sum, s) => sum + s.value, 0) || 1;
				const cx = size / 2;
				const cy = size / 2;
				const radius = size / 2 - 2;
				let angle = -Math.PI / 2;
				const paths = segments
					.filter(s => s.value > 0)
					.map(s => {
						const startA = angle;
						const endA = angle + (s.value / total) * Math.PI * 2;
						angle = endA;
						return (
							'<path class="slice" data-filter="' +
							s.filter +
							'" style="cursor:pointer" d="' +
							arcWedge(cx, cy, radius, startA, endA - 0.004) +
							'" fill="' +
							s.color +
							'"><title>' +
							s.label +
							': ' +
							s.value +
							'</title></path>'
						);
					})
					.join('');
				return (
					'<svg width="' +
					size +
					'" height="' +
					size +
					'" viewBox="0 0 ' +
					size +
					' ' +
					size +
					'">' +
					paths +
					'<circle cx="' +
					cx +
					'" cy="' +
					cy +
					'" r="' +
					radius * 0.58 +
					'" fill="#fff"></circle>' +
					'<text x="' +
					cx +
					'" y="' +
					(cy + 6) +
					'" text-anchor="middle" fill="#1b243f" font-size="22" font-weight="700">' +
					total +
					'</text></svg>'
				);
			}

			function tileStats(def) {
				if (def.seo) {
					const seo = (REPORT.signals && REPORT.signals.seo) || {
						totalStories: 0,
						withTitle: 0,
					};
					return { have: seo.withTitle, total: seo.totalStories, unit: 'stories' };
				}
				const total = REPORT.components.length;
				const have = total - REPORT.components.filter(def.bad).length;
				return { have, total, unit: 'components' };
			}

			function categoryScores() {
				const tilePct = {};
				buildTiles().forEach(t => {
					tilePct[t.id] = t.pct;
				});
				const usedPct = REPORT.summary.totalComponents
					? Math.round(
							(REPORT.summary.usedComponents / REPORT.summary.totalComponents) * 100
						)
					: 0;
				return CATEGORIES.map(cat => {
					let pct;
					if (cat.adoption) pct = usedPct;
					else {
						const vals = cat.signals.map(id => tilePct[id] ?? 0);
						pct = Math.round(vals.reduce((s, v) => s + v, 0) / vals.length);
					}
					return { key: cat.key, pct };
				});
			}

			function buildTiles() {
				return TILE_DEFS.map(def => {
					const st = tileStats(def);
					const pct = st.total ? Math.round((st.have / st.total) * 100) : 0;
					return {
						...def,
						have: st.have,
						total: st.total,
						unit: st.unit,
						missing: st.total - st.have,
						pct,
					};
				});
			}

			function coverageScore() {
				const cats = categoryScores();
				if (!cats.length) return 0;
				return Math.round(cats.reduce((sum, c) => sum + c.pct, 0) / cats.length);
			}

			function renderCats() {
				document.getElementById('cats').innerHTML = categoryScores()
					.map(c => {
						const color = severity(c.pct);
						return (
							'<div class="cat"><span class="cname">' +
							c.key +
							'</span><span class="ctrack"><span style="width:' +
							c.pct +
							'%;background:' +
							color +
							'"></span></span><span class="cval" style="color:' +
							color +
							'">' +
							c.pct +
							'%</span></div>'
						);
					})
					.join('');
			}

			function renderTiles() {
				const tiles = buildTiles().sort((a, b) => a.pct - b.pct);
				document.getElementById('tiles').innerHTML = tiles
					.map(t => {
						const color = severity(t.pct);
						const tint = color + '22';
						const done = t.missing === 0;
						const fixLabel = done
							? '✓ All set'
							: (t.review ? 'Review ' : 'Fix ') +
								t.missing +
								' ' +
								(t.unit === 'stories' ? 'stories' : 'components') +
								' →';
						return (
							'<div class="tile' +
							(done ? ' done' : '') +
							'">' +
							'<div class="head">' +
							'<span class="emoji" style="background:' +
							tint +
							'">' +
							t.emoji +
							'</span>' +
							'<span class="title">' +
							t.label +
							'</span>' +
							'<span class="pct" style="color:' +
							color +
							'">' +
							t.pct +
							'%</span>' +
							'</div>' +
							'<div class="desc">' +
							t.desc +
							'</div>' +
							'<div class="bar"><span style="width:' +
							t.pct +
							'%;background:' +
							color +
							'"></span></div>' +
							'<div class="meta">' +
							t.have +
							' / ' +
							t.total +
							' ' +
							t.unit +
							' have it</div>' +
							'<button class="fix" data-tile="' +
							t.id +
							'" style="background:' +
							(done ? '#e9ecf4' : color) +
							'">' +
							fixLabel +
							'</button>' +
							'</div>'
						);
					})
					.join('');
				document.querySelectorAll('.tile .fix').forEach(b => {
					if (!b.closest('.tile').classList.contains('done')) {
						b.addEventListener('click', () => openWizard(b.getAttribute('data-tile')));
					}
				});
			}

			function openWizard(tileId) {
				const def = TILE_DEFS.find(d => d.id === tileId);
				if (!def) return;
				const st = tileStats(def);
				const missing = st.total - st.have;
				document.getElementById('wz-emoji').textContent = def.emoji;
				document.getElementById('wz-emoji').style.background = '#eef0f7';
				document.getElementById('wz-title').textContent = 'Fix: ' + def.label;
				document.getElementById('wz-sub').textContent =
					missing + ' ' + st.unit + ' are missing ' + def.label.toLowerCase() + '.';

				const affectedEl = document.getElementById('wz-affected');
				const filterBtn = document.getElementById('wz-filter');
				const startBtn = document.getElementById('wz-start');
				const noteEl = document.getElementById('wz-note');

				if (def.seo) {
					document.getElementById('wz-affected-label').textContent = 'Detected';
					affectedEl.innerHTML =
						'<span>' +
						missing +
						' stories without a meta ' +
						def.label.toLowerCase() +
						'</span>';
					filterBtn.style.display = 'none';
				} else {
					filterBtn.style.display = '';
					const names = REPORT.components.filter(def.bad).map(c => c.name);
					document.getElementById('wz-affected-label').textContent =
						'Affected components (' + names.length + ')';
					const shown = names.slice(0, 24);
					const more =
						names.length > shown.length
							? '<span>+ ' + (names.length - shown.length) + ' more</span>'
							: '';
					if (def.id === 'preview') {
						affectedEl.innerHTML =
							shown
								.map(
									n =>
										'<button class="shot" data-comp="' +
										escapeHtml(n) +
										'">' +
										escapeHtml(n) +
										'</button>'
								)
								.join('') + more;
						affectedEl
							.querySelectorAll('button.shot')
							.forEach(b => b.addEventListener('click', () => shootComponent(b)));
					} else {
						affectedEl.innerHTML =
							shown.map(n => '<span>' + escapeHtml(n) + '</span>').join('') + more;
					}
				}

				filterBtn.onclick = () => {
					closeWizard();
					if (def.filter) setFilter(def.filter);
				};

				if (def.id === 'preview') {
					noteEl.textContent =
						'Click a component to screenshot it, or run all visible — triggers the screenshot webhook.';
					startBtn.style.display = '';
					startBtn.disabled = false;
					startBtn.textContent = 'Generate screenshots';
					startBtn.onclick = () => runScreenshots();
				} else if (def.review) {
					noteEl.textContent =
						'Review these in the table and scope or remove them in Storyblok.';
					startBtn.style.display = 'none';
					startBtn.onclick = null;
				} else {
					noteEl.textContent =
						'AI proposals need live mode + ANTHROPIC_API_KEY (autofix pipeline).';
					startBtn.style.display = '';
					startBtn.disabled = true;
					startBtn.textContent = 'Generate AI proposals';
					startBtn.onclick = null;
				}

				document.getElementById('wizard').classList.add('open');
			}

			async function shootComponent(btn) {
				const name = btn.getAttribute('data-comp');
				btn.disabled = true;
				btn.textContent = '⏳ ' + name;
				try {
					const res = await fetch(
						'/api/screenshot?componentName=' + encodeURIComponent(name)
					);
					const data = await res.json();
					if (data.ok) {
						btn.style.background = '#e7f6ee';
						btn.style.borderColor = '#4caf7d';
						btn.textContent = '✓ ' + name;
					} else {
						btn.style.background = '#fdeef0';
						btn.style.borderColor = '#e2526b';
						btn.textContent = '✗ ' + name;
						btn.title = 'webhook status ' + (data.status || data.error || 'error');
					}
				} catch (error) {
					btn.style.background = '#fdeef0';
					btn.style.borderColor = '#e2526b';
					btn.textContent = '✗ ' + name;
					btn.title = String(error);
				}
				btn.disabled = false;
			}

			async function runScreenshots() {
				const btns = Array.from(document.querySelectorAll('#wz-affected button.shot'));
				const startBtn = document.getElementById('wz-start');
				const noteEl = document.getElementById('wz-note');
				startBtn.disabled = true;
				for (let i = 0; i < btns.length; i++) {
					noteEl.textContent = 'Screenshotting ' + (i + 1) + ' / ' + btns.length + '…';
					await shootComponent(btns[i]);
				}
				noteEl.textContent = 'Done — triggered ' + btns.length + ' screenshot webhooks.';
				startBtn.disabled = false;
			}

			function closeWizard() {
				document.getElementById('wizard').classList.remove('open');
			}

			function renderActive() {
				document
					.querySelectorAll('.leg .r')
					.forEach(r =>
						r.classList.toggle('active', r.getAttribute('data-filter') === activeFilter)
					);
			}

			function renderRoleDonut() {
				const s = REPORT.summary;
				const segs = [
					{ label: 'Page type', value: s.rolePage, color: RC.page, filter: 'role:page' },
					{
						label: 'Page section',
						value: s.roleSection,
						color: RC.section,
						filter: 'role:section',
					},
					{
						label: 'Subcomponent',
						value: s.roleSubcomponent,
						color: RC.subcomponent,
						filter: 'role:subcomponent',
					},
					{
						label: 'Unused',
						value: s.roleUnused,
						color: RC.unused,
						filter: 'role:unused',
					},
				];
				document.getElementById('donut').innerHTML = donut(segs, 150);
				document.getElementById('leg').innerHTML = segs
					.map(
						seg =>
							'<div class="r" data-filter="' +
							seg.filter +
							'"><span class="sw" style="background:' +
							seg.color +
							'"></span><b>' +
							seg.value +
							'</b> <span class="m">' +
							seg.label +
							'</span></div>'
					)
					.join('');
				document
					.querySelectorAll('#donut .slice, .leg .r')
					.forEach(el =>
						el.addEventListener('click', () =>
							setFilter(el.getAttribute('data-filter'))
						)
					);
			}

			function renderTable() {
				const term = document.getElementById('search').value.toLowerCase();
				const rows = REPORT.components
					.filter(c => c.name.toLowerCase().includes(term) && predicate(c, activeFilter))
					.sort((a, b) => {
						const av = a[sortKey];
						const bv = b[sortKey];
						if (typeof av === 'string')
							return (av || '').localeCompare(bv || '') * sortDir;
						return (av - bv) * sortDir;
					});
				document.getElementById('rowcount').textContent =
					rows.length + ' of ' + REPORT.components.length + ' components';
				document.getElementById('rows').innerHTML = rows
					.map(
						c =>
							'<tr>' +
							'<td class="comp">' +
							escapeHtml(c.name) +
							'</td>' +
							'<td><span class="pill" style="background:' +
							RC[c.role] +
							'22;color:' +
							RC[c.role] +
							'">' +
							c.role +
							'</span></td>' +
							'<td>' +
							c.classification +
							'</td>' +
							'<td class="num">' +
							c.pageSectionUsage +
							'</td>' +
							'<td class="num ' +
							(c.totalUsage === 0 ? 'zero' : '') +
							'">' +
							c.totalUsage +
							'</td>' +
							'<td class="num">' +
							c.nestedUsage +
							'</td>' +
							'<td class="num">' +
							c.storyCount +
							'</td>' +
							'<td>' +
							iconBadge(c) +
							'</td>' +
							'<td>' +
							dot(c.hasPreview) +
							'</td>' +
							'<td>' +
							dot(c.hasPreset) +
							'</td>' +
							'</tr>'
					)
					.join('');
			}

			function render() {
				const s = REPORT.summary;
				document.getElementById('subtitle').textContent =
					'Space ' +
					REPORT.spaceId +
					' · ' +
					REPORT.storiesAnalysed +
					' stories · ' +
					s.totalComponents +
					' components · ' +
					REPORT.contentVersion;

				const cards = [
					{ num: s.totalComponents, lbl: 'Components', color: '#6b5ce7' },
					{ num: s.pageSectionComponents, lbl: 'In page body', color: RC.section },
					{ num: s.rolePage, lbl: 'Page types', color: RC.page },
					{ num: s.roleSubcomponent, lbl: 'Subcomponents', color: RC.subcomponent },
					{ num: s.roleUnused, lbl: 'Unused', color: RC.unused },
				];
				document.getElementById('cards').innerHTML = cards
					.map(
						c =>
							'<div class="card"><div class="num" style="color:' +
							c.color +
							'">' +
							c.num +
							'</div><div class="lbl">' +
							c.lbl +
							'</div></div>'
					)
					.join('');

				document.getElementById('gauge').innerHTML = gauge(coverageScore());
				renderCats();
				renderTiles();
				renderRoleDonut();
				renderChips();
				renderActive();

				document.querySelectorAll('th[data-sort]').forEach(th => {
					th.addEventListener('click', () => {
						const key = th.getAttribute('data-sort');
						if (sortKey === key) sortDir *= -1;
						else {
							sortKey = key;
							sortDir = typeof REPORT.components[0][key] === 'string' ? 1 : -1;
						}
						renderTable();
					});
				});
				document.getElementById('search').addEventListener('input', renderTable);

				document.getElementById('state').style.display = 'none';
				document.getElementById('dashboard').style.display = 'block';
				renderTable();
			}

			async function load(source, label) {
				const state = document.getElementById('state');
				document.getElementById('dashboard').style.display = 'none';
				state.className = 'state';
				state.style.display = 'block';
				state.textContent = 'Loading ' + label + '…';
				try {
					const response = await fetch(source);
					const body = await response.json();
					if (!response.ok)
						throw new Error(body.error || 'Request failed (' + response.status + ')');
					REPORT = body;
					render();
				} catch (error) {
					state.className = 'state error';
					state.textContent = 'Failed to load ' + label + ': ' + error.message;
				}
			}

			document
				.getElementById('btn-static')
				.addEventListener('click', () => load(staticData, 'static snapshot'));
			document
				.getElementById('btn-live')
				.addEventListener('click', () => load(liveEndpoint, 'live data'));
			document.getElementById('wz-close').addEventListener('click', closeWizard);
			document.getElementById('wizard').addEventListener('click', e => {
				if (e.target.id === 'wizard') closeWizard();
			});

			load(staticData, 'static snapshot');
		</script>
	</body>
</html>
