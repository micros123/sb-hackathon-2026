---
import Header from 'components/chrome/Header.astro';
import Footer from 'components/chrome/Footer.astro';
import type { Audience } from 'utils/storyblok';

import 'styles/global.css';

type Props = { title?: string; audience?: Audience };

const { title = 'Astoria', audience } = Astro.props as Props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<title>{title} — Astoria</title>
	</head>
	<body class="bg-white font-proxima">
		<Header audience={audience} />
		<slot />
		<Footer />

		<script>
			import { loadStoryblokBridge } from '@storyblok/astro';

			//* Only inside the Storyblok Visual Editor (its iframe adds _storyblok params).
			//* The bridge enables click-to-edit highlighting; we reload on change/publish
			//* so the SSR page re-renders the latest draft.
			const isEditor = new URLSearchParams(window.location.search).has('_storyblok');

			if (isEditor) {
				loadStoryblokBridge().then(() => {
					const bridge = new window.StoryblokBridge();
					bridge.on(['change', 'published'], () => window.location.reload());
				});
			}
		</script>
	</body>
</html>
